NEXT_PUBLIC_SITE_URL=https://app.normalfinance.io

# Public resource directory
NEXT_PUBLIC_ASSETS_DIR=

# Stellar
NEXT_PUBLIC_NETWORK=TESTNET
RPC_API_KEY=""

# Sentry
SENTRY_ORG=normal-finance
SENTRY_PROJECT=normal-stellar
NEXT_PUBLIC_SENTRY_DSN=

# Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=
CRISP_SECRET_KEY=

# On-ramp providers
NEXT_PUBLIC_COINBASE_PROJECT_ID=
NEXT_PUBLIC_ONRAMPER_API_KEY=

# Geo-fencing
GEOIP_ENDPOINT=https://api.ipregistry.co/
GEOIPKEY=

# Announcements
NEXT_PUBLIC_ANNOUNCEMENT_TITLE=
NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE=
NEXT_PUBLIC_ANNOUNCEMENT_FORMAT=markdown

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Blux Integration
# Enable or disable Blux authentication (true/false)
NEXT_PUBLIC_ENABLE_BLUX_AUTH=false

# Note: To enable Blux authentication:
# 1. Set NEXT_PUBLIC_ENABLE_BLUX_AUTH=true
# 2. No API keys needed - Blux handles authentication internally
# 3. Configure authentication methods in src/lib/blux-config.ts