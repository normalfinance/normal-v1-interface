# =============================================================================
# NORMAL FINANCE FEES
# =============================================================================
# Stellar G-address (classic account) that receives all Normal Finance
# fees and commissions — the 0.5% savings deposit fee, the tiered yield
# commission on withdrawal (5%–20% depending on withdrawal size), and
# the 0.5% swap fee. Must have a USDC trustline before USDC-denominated
# fees can be received.
NORMAL_FEES_DEPOSIT_ADDRESS=

# =============================================================================
# SOROSWAP AGGREGATOR (SWAPS)
# =============================================================================
# Server-only — not NEXT_PUBLIC. The browser never sees these.
# Provision the API key from the Palta Labs team (https://api.soroswap.finance).
SOROSWAP_API_BASE_URL=https://api.soroswap.finance
SOROSWAP_API_KEY=

