generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_TESTNET_URL")
  directUrl = env("DATABASE_TESTNET_URL")
}

model User {
  id                String           @id @default(cuid())
  walletAddress     String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  actions           ReferralAction[]
  referralsReceived Referral[]       @relation("Referee")
  referralsGiven    Referral[]       @relation("Referrer")

  @@map("users")
}

model Referral {
  id         String           @id @default(cuid())
  code       String           @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  referrerId String
  refereeId  String?
  isActive   Boolean          @default(true)
  isUsed     Boolean          @default(false)
  usedAt     DateTime?
  source     String?
  campaign   String?
  actions    ReferralAction[]
  referee    User?            @relation("Referee", fields: [refereeId], references: [id])
  referrer   User             @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

model ReferralAction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  referralId  String
  action      String
  amount      String?
  tokenSymbol String?
  metadata    Json?
  referral    Referral @relation(fields: [referralId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, referralId, action])
  @@map("referral_actions")
}

model LinkedWallet {
  id            String   @id @default(cuid())
  supabaseUid   String
  walletAddress String
  walletName    String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@unique([supabaseUid, walletAddress])
  @@index([supabaseUid])
  @@map("linked_wallets")
}

model VaultDeposit {
  id            String   @id @default(cuid())
  walletAddress String
  vaultAddress  String
  type          String   // "deposit" or "withdraw"
  amount        String   // USDC amount (human-readable, not stroops)
  feeAmount     String?  // Normal fee (deposit) or commission (withdraw), human-readable USDC
  feeTxHash     String?  // Hash of the classic fee payment transaction
  txHash        String?
  // #27 record-before-broadcast: pending | submitted | confirmed | failed | abandoned.
  // Legacy rows (written only after success) default to confirmed via the SQL default.
  status        String   @default("confirmed")
  statusReason  String?  // e.g. Horizon result codes on failure
  network       String?  // "mainnet" | "testnet"; null on legacy rows
  createdAt     DateTime @default(now())

  @@index([walletAddress, vaultAddress])
  @@index([status])
  @@index([txHash])
  @@map("vault_deposits")
}

model SwapLog {
  id               String   @id @default(cuid())
  walletAddress    String
  tokenInAddress   String
  tokenOutAddress  String
  tokenInSymbol    String?
  tokenOutSymbol   String?
  amountIn         String
  amountOut        String
  feeAmount        String?  // 0.5% fee charged in tokenIn (human-readable)
  feeTxHash        String?  // Hash of the classic fee payment transaction
  txHash           String?
  // #27 record-before-broadcast: pending | submitted | confirmed | failed | abandoned.
  // Legacy rows (written only after success) default to confirmed via the SQL default.
  status           String   @default("confirmed")
  statusReason     String?  // e.g. Horizon result codes on failure
  network          String?  // "mainnet" | "testnet"; null on legacy rows
  createdAt        DateTime @default(now())

  @@index([walletAddress])
  @@index([status])
  @@index([txHash])
  @@map("swap_logs")
}

// Cross-ecosystem swap via CCTP (Soroswap → CCTP → LI.FI composite). One row
// per transfer, driving a resumable state machine — the row is created and the
// burn intent persisted BEFORE the burn tx is broadcast, so a crashed process
// can always be recovered (attestations are re-fetchable from Iris forever).
// status: CREATED | SRC_SWAP_DONE | BURN_SUBMITTED | BURN_CONFIRMED | ATTESTED
//       | MINT_SUBMITTED | MINT_CONFIRMED | DST_SWAP_PENDING | COMPLETED
//       | NEEDS_REATTEST | FAILED
model CctpTransfer {
  id             String   @id @default(cuid())
  userId         String   // supabase uid
  network        String   @default("mainnet") // 'mainnet' | 'testnet' — cron advances rows without request context
  direction      String   // 'stellar_to_evm' | 'evm_to_stellar' | 'stellar_to_solana' | ...
  status         String   @default("CREATED")
  sourceDomain   Int      // CCTP domain id of the burn chain
  destDomain     Int      // CCTP domain id of the mint chain
  amountWire     String   // canonical 6-dp integer units, as string
  srcAsset       String   // user-facing source asset symbol (e.g. 'XLM')
  dstAsset       String   // user-facing destination asset symbol (e.g. 'BTC')
  srcAmount      String?  // human source amount for the activity feed (e.g. '0.5')
  dstAmount      String?  // human delivered amount, set on completion
  srcAddress     String
  destAddress    String
  srcSwapTxHash  String?  // Soroswap/LI.FI leg before the burn
  burnTxHash     String?
  eventNonce     String?
  messageHex     String?
  attestationHex String?
  mintTxHash     String?
  dstSwapTxHash  String?  // LI.FI/Soroswap leg after the mint
  gasTopUpTxHash String?  // relayer dust-gas send on the burn chain (once)
  quoteJson      String?  // full quote snapshot incl. fee breakdown
  errorDetail    String?
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([burnTxHash])
  @@map("cctp_transfers")
}

// Our record of a MoneyGram SEP-24 transaction, written when our server
// initiates it. MoneyGram stays the source of truth for status — this row is a
// cache so the activity feed can render MGI history without a SEP-10 passkey
// ceremony; clients report fresh statuses back after fetching them.
model MoneyGramTransaction {
  id                    String   @id // MoneyGram's SEP-24 transaction id
  supabaseUid           String
  walletAddress         String
  kind                  String // "deposit" | "withdrawal"
  status                String   @default("incomplete")
  amount                String? // expected USDC amount (human-readable)
  externalTransactionId String? // MoneyGram reference number (withdrawals, once available)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([supabaseUid])
  @@index([walletAddress])
  @@map("moneygram_transactions")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
// #29 record-before-broadcast for native ETH/SOL sends. Row written (with the
// pre-computable tx hash and, on EVM, the nonce) BEFORE the server broadcasts;
// settled pending → submitted → confirmed/failed/abandoned by the route and
// the cron reconciler. A non-terminal row blocks further sends on that
// wallet+chain — the structural double-send guard. Not wired into activity
// feeds (sends already surface via chain activity APIs + #47 pending rows).
model SendLog {
  id            String   @id @default(cuid())
  walletAddress String
  chain         String   // registry ChainId: 'ethereum' | 'solana'
  symbol        String?
  amount        String
  destination   String
  txHash        String?
  nonce         Int?     // EVM only — the double-send key
  status        String   @default("pending")
  statusReason  String?
  network       String?
  createdAt     DateTime @default(now())

  @@index([walletAddress])
  @@index([status])
  @@index([txHash])
  @@map("send_logs")
}

// #24: "we owe the provider an on-chain send for sale X" — previously
// localStorage (device-local: cleared browser / second device = amnesia and a
// stuck sale). txHash null = claimed, in progress; set = fulfilled. Rows are
// keyed on the session user; the activity feed joins them with the provider's
// live status by providerTxnId.
/// One record per handoff to a ramp provider (doc 89 F2): written BEFORE the
/// user leaves, tracked until the chain confirms. walletAddress is the
/// WalletChoice-selected wallet. Table ships as additive SQL:
/// docs/audit/sql/ramp_transfers.sql
model RampTransfer {
  id              String    @id @default(cuid())
  supabaseUid     String
  network         String    @default("mainnet")
  direction       String // 'onramp' | 'offramp'
  provider        String // 'coinbase' | 'moonpay' | ...
  asset           String
  chain           String
  walletAddress   String
  amountExpected  String?
  amountFinal     String?
  status          String    @default("committed")
  providerRef     String?
  baselineBalance String?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  settledAt       DateTime?

  @@index([supabaseUid])
  @@index([status])
  @@index([supabaseUid, status])
  @@map("ramp_transfers")
}

model OfframpFill {
  id            String   @id @default(cuid())
  supabaseUid   String
  provider      String   @default("coinbase")
  providerTxnId String
  txHash        String?
  createdAt     DateTime @default(now())

  @@unique([supabaseUid, providerTxnId])
  @@index([supabaseUid])
  @@map("offramp_fills")
}

model TurnkeyWallet {
  id              String   @id @default(cuid())
  supabaseUid     String   @unique
  subOrgId        String   @unique
  walletId        String
  bitcoinAddress  String?
  ethereumAddress String?
  solanaAddress   String?
  stellarAddress  String?
  createdAt       DateTime @default(now())

  @@index([supabaseUid])
  @@map("turnkey_wallets")
}

/// One row per Turnkey WALLET (seed). A sub-organization can hold several;
/// TurnkeyWallet above stays the user's sub-org + PRIMARY wallet, and this is
/// the full list. Signing never uses walletId (Turnkey signs by
/// organizationId + address), so this table is for records and display only.
/// Table ships as additive SQL: docs/audit/sql/turnkey_wallet_seeds.sql
model TurnkeyWalletSeed {
  id              String   @id @default(cuid())
  supabaseUid     String
  walletId        String
  label           String?
  /// 'created' (made in-app) | 'imported' (a phrase the user brought)
  origin          String   @default("created")
  isPrimary       Boolean  @default(false)
  bitcoinAddress  String?
  ethereumAddress String?
  solanaAddress   String?
  stellarAddress  String?
  createdAt       DateTime @default(now())

  @@unique([supabaseUid, walletId], map: "turnkey_wallet_seeds_uid_wallet_key")
  @@index([supabaseUid])
  @@index([stellarAddress])
  @@map("turnkey_wallet_seeds")
}

model normal_contract_events {
  id                          String   @id
  type                        String
  contract_id                 String?
  topics                      String?
  data                        String?
  in_successful_contract_call Boolean
  transaction_hash            String?
  transaction_account         String?
  transaction_fee_account     String?
  transaction_successful      Boolean?
  transaction_index           Int?
  operation_body              String?
  operation_result_code       String?
  operation_type              String?
  ledger_sequence             BigInt
  ledger_hash                 String
  ledger_closed_at            DateTime @db.Timestamp(6)
  ledger_signature            String?
}
