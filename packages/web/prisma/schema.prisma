generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_MAINNET_URL")
  directUrl = env("DATABASE_MAINNET_URL")
}

model User {
  id                String           @id @default(cuid())
  walletAddress     String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  actions           ReferralAction[]
  referralsReceived Referral[]       @relation("Referee")
  referralsGiven    Referral[]       @relation("Referrer")

  @@map("users")
}

model Referral {
  id         String           @id @default(cuid())
  code       String           @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  referrerId String
  refereeId  String?
  isActive   Boolean          @default(true)
  isUsed     Boolean          @default(false)
  usedAt     DateTime?
  source     String?
  campaign   String?
  actions    ReferralAction[]
  referee    User?            @relation("Referee", fields: [refereeId], references: [id])
  referrer   User             @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

model ReferralAction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  referralId  String
  action      String
  amount      String?
  tokenSymbol String?
  metadata    Json?
  referral    Referral @relation(fields: [referralId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, referralId, action])
  @@map("referral_actions")
}

model LinkedWallet {
  id                  String    @id @default(cuid())
  supabaseUid         String
  walletAddress       String
  walletName          String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime  @default(now())
  custodyChoice       String?
  encryptedMnemonic   String?
  encryptionIV        String?
  encryptionSalt      String?
  custodyConsentEmail String?
  custodyConsentDate  DateTime?

  @@unique([supabaseUid, walletAddress])
  @@index([supabaseUid])
  @@map("linked_wallets")
}

model UserRSAKeys {
  id                  String   @id @default(cuid())
  supabaseUid         String   @unique
  publicKey           String   @db.Text
  encryptedPrivateKey String   @db.Text
  privateKeyIV        String
  privateKeySalt      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_rsa_keys")
}

model SponsoredAccount {
  id               String    @id @default(cuid())
  supabaseUid      String?
  walletAddress    String    @unique
  sponsorAddress   String
  ipAddress        String
  sponsoredAt      DateTime  @default(now())
  accountReserve   String    @default("0.5")
  trustlineReserve String    @default("0.5")
  feePayment       String    @default("1")
  txHash           String?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revocationTxHash String?
  revocationReason String?

  @@index([sponsorAddress])
  @@index([ipAddress])
  @@index([supabaseUid])
  @@map("sponsored_accounts")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model normal_contract_events {
  id                          String   @id
  type                        String
  contract_id                 String?
  topics                      String?
  data                        String?
  in_successful_contract_call Boolean
  transaction_hash            String?
  transaction_account         String?
  transaction_fee_account     String?
  transaction_successful      Boolean?
  transaction_index           Int?
  operation_body              String?
  operation_result_code       String?
  operation_type              String?
  ledger_sequence             BigInt
  ledger_hash                 String
  ledger_closed_at            DateTime @db.Timestamp(6)
  ledger_signature            String?
}
