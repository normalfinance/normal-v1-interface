generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_TESTNET_URL")
  directUrl = env("DATABASE_TESTNET_URL")
}

model User {
  id                String           @id @default(cuid())
  walletAddress     String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  actions           ReferralAction[]
  referralsReceived Referral[]       @relation("Referee")
  referralsGiven    Referral[]       @relation("Referrer")

  @@map("users")
}

model Referral {
  id         String           @id @default(cuid())
  code       String           @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  referrerId String
  refereeId  String?
  isActive   Boolean          @default(true)
  isUsed     Boolean          @default(false)
  usedAt     DateTime?
  source     String?
  campaign   String?
  actions    ReferralAction[]
  referee    User?            @relation("Referee", fields: [refereeId], references: [id])
  referrer   User             @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

model ReferralAction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  referralId  String
  action      String
  amount      String?
  tokenSymbol String?
  metadata    Json?
  referral    Referral @relation(fields: [referralId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, referralId, action])
  @@map("referral_actions")
}

model LinkedWallet {
  id            String   @id @default(cuid())
  supabaseUid   String
  walletAddress String
  walletName    String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@unique([supabaseUid, walletAddress])
  @@index([supabaseUid])
  @@map("linked_wallets")
}

model VaultDeposit {
  id            String   @id @default(cuid())
  walletAddress String
  vaultAddress  String
  type          String   // "deposit" or "withdraw"
  amount        String   // USDC amount (human-readable, not stroops)
  feeAmount     String?  // Normal fee (deposit) or commission (withdraw), human-readable USDC
  feeTxHash     String?  // Hash of the classic fee payment transaction
  txHash        String?
  createdAt     DateTime @default(now())

  @@index([walletAddress, vaultAddress])
  @@map("vault_deposits")
}

model SwapLog {
  id               String   @id @default(cuid())
  walletAddress    String
  tokenInAddress   String
  tokenOutAddress  String
  tokenInSymbol    String?
  tokenOutSymbol   String?
  amountIn         String
  amountOut        String
  feeAmount        String?  // 0.5% fee charged in tokenIn (human-readable)
  feeTxHash        String?  // Hash of the classic fee payment transaction
  txHash           String?
  createdAt        DateTime @default(now())

  @@index([walletAddress])
  @@map("swap_logs")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model normal_contract_events {
  id                          String   @id
  type                        String
  contract_id                 String?
  topics                      String?
  data                        String?
  in_successful_contract_call Boolean
  transaction_hash            String?
  transaction_account         String?
  transaction_fee_account     String?
  transaction_successful      Boolean?
  transaction_index           Int?
  operation_body              String?
  operation_result_code       String?
  operation_type              String?
  ledger_sequence             BigInt
  ledger_hash                 String
  ledger_closed_at            DateTime @db.Timestamp(6)
  ledger_signature            String?
}
