generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_TESTNET_URL")
  directUrl = env("DATABASE_TESTNET_URL")
}

model User {
  id                String           @id @default(cuid())
  walletAddress     String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  actions           ReferralAction[]
  referralsReceived Referral[]       @relation("Referee")
  referralsGiven    Referral[]       @relation("Referrer")

  @@map("users")
}

model Referral {
  id         String           @id @default(cuid())
  code       String           @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  referrerId String
  refereeId  String?
  isActive   Boolean          @default(true)
  isUsed     Boolean          @default(false)
  usedAt     DateTime?
  source     String?
  campaign   String?
  actions    ReferralAction[]
  referee    User?            @relation("Referee", fields: [refereeId], references: [id])
  referrer   User             @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

model ReferralAction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  referralId  String
  action      String
  amount      String?
  tokenSymbol String?
  metadata    Json?
  referral    Referral @relation(fields: [referralId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, referralId, action])
  @@map("referral_actions")
}

model LinkedWallet {
  id            String   @id @default(cuid())
  supabaseUid   String
  walletAddress String
  walletName    String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@unique([supabaseUid, walletAddress])
  @@index([supabaseUid])
  @@map("linked_wallets")
}

model VaultDeposit {
  id            String   @id @default(cuid())
  walletAddress String
  vaultAddress  String
  type          String   // "deposit" or "withdraw"
  amount        String   // USDC amount (human-readable, not stroops)
  feeAmount     String?  // Normal fee (deposit) or commission (withdraw), human-readable USDC
  feeTxHash     String?  // Hash of the classic fee payment transaction
  txHash        String?
  createdAt     DateTime @default(now())

  @@index([walletAddress, vaultAddress])
  @@map("vault_deposits")
}

model SwapLog {
  id               String   @id @default(cuid())
  walletAddress    String
  tokenInAddress   String
  tokenOutAddress  String
  tokenInSymbol    String?
  tokenOutSymbol   String?
  amountIn         String
  amountOut        String
  feeAmount        String?  // 0.5% fee charged in tokenIn (human-readable)
  feeTxHash        String?  // Hash of the classic fee payment transaction
  txHash           String?
  createdAt        DateTime @default(now())

  @@index([walletAddress])
  @@map("swap_logs")
}

// Cross-ecosystem swap via CCTP (Soroswap → CCTP → LI.FI composite). One row
// per transfer, driving a resumable state machine — the row is created and the
// burn intent persisted BEFORE the burn tx is broadcast, so a crashed process
// can always be recovered (attestations are re-fetchable from Iris forever).
// status: CREATED | SRC_SWAP_DONE | BURN_SUBMITTED | BURN_CONFIRMED | ATTESTED
//       | MINT_SUBMITTED | MINT_CONFIRMED | DST_SWAP_PENDING | COMPLETED
//       | NEEDS_REATTEST | FAILED
model CctpTransfer {
  id             String   @id @default(cuid())
  userId         String   // supabase uid
  direction      String   // 'stellar_to_evm' | 'evm_to_stellar' | 'stellar_to_solana' | ...
  status         String   @default("CREATED")
  sourceDomain   Int      // CCTP domain id of the burn chain
  destDomain     Int      // CCTP domain id of the mint chain
  amountWire     String   // canonical 6-dp integer units, as string
  srcAsset       String   // user-facing source asset symbol (e.g. 'XLM')
  dstAsset       String   // user-facing destination asset symbol (e.g. 'BTC')
  srcAddress     String
  destAddress    String
  srcSwapTxHash  String?  // Soroswap/LI.FI leg before the burn
  burnTxHash     String?
  eventNonce     String?
  messageHex     String?
  attestationHex String?
  mintTxHash     String?
  dstSwapTxHash  String?  // LI.FI/Soroswap leg after the mint
  quoteJson      String?  // full quote snapshot incl. fee breakdown
  errorDetail    String?
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([burnTxHash])
  @@map("cctp_transfers")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model TurnkeyWallet {
  id              String   @id @default(cuid())
  supabaseUid     String   @unique
  subOrgId        String   @unique
  walletId        String
  bitcoinAddress  String?
  ethereumAddress String?
  solanaAddress   String?
  stellarAddress  String?
  createdAt       DateTime @default(now())

  @@index([supabaseUid])
  @@map("turnkey_wallets")
}

model normal_contract_events {
  id                          String   @id
  type                        String
  contract_id                 String?
  topics                      String?
  data                        String?
  in_successful_contract_call Boolean
  transaction_hash            String?
  transaction_account         String?
  transaction_fee_account     String?
  transaction_successful      Boolean?
  transaction_index           Int?
  operation_body              String?
  operation_result_code       String?
  operation_type              String?
  ledger_sequence             BigInt
  ledger_hash                 String
  ledger_closed_at            DateTime @db.Timestamp(6)
  ledger_signature            String?
}
