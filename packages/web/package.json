    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-charts": "^8.10.0",
    "@mui/x-data-grid": "^8.10.0",
    "@mui/x-date-pickers": "^8.10.0",
    "@mui/x-tree-view": "^8.10.0",
    "@normalfinance/state": "workspace:^",
    "@normalfinance/types": "workspace:^",
    "@normalfinance/utils": "workspace:^",
    "@prisma/client": "^6.14.0",
