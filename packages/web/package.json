    "i18next-resources-to-backend": "^1.2.1",
    "lowlight": "^3.3.0",
    "minimal-shared": "^1.0.5",
    "mui-one-time-password-input": "^5.0.0",
    "next": "^15.4.6",
    "notistack": "^3.0.2",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-apexcharts": "^1.7.0",
