    "react-i18next": "^15.4.0",
    "react-joyride": "^2.9.3",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.10",
    "rehype-highlight": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "simplebar-react": "^3.3.0",
    "sonner": "^2.0.7",
    "stellar-sdk": "^13.3.0",
    "stylis": "^4.3.4",
    "stylis-plugin-rtl": "^2.1.1",
    "swr": "^2.3.6",
    "turndown": "^7.2.0",
    "yet-another-react-lightbox": "^3.21.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@crowdin/cli": "^4.9.1",
