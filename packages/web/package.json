{
  "name": "@normalfinance/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "i18n:extract": "npx i18next-parser && node ./scripts/fix-empty-i18n-values.js",
    "i18n:upload": "crowdin upload sources",
    "i18n:pretranslate": "bash -c 'if [ -n \"$CROWDIN_MT_ENGINE_ID\" ]; then echo \"🔄  Pre-translating with MT engine $CROWDIN_MT_ENGINE_ID\"; crowdin pre-translate --method mt --engine-id=$CROWDIN_MT_ENGINE_ID; else echo \"⚠️  CROWDIN_MT_ENGINE_ID not set, skipping primary MT\"; fi; if [ -n \"$CROWDIN_FALLBACK_MT_ENGINE_ID\" ]; then echo \"🔄  Fallback MT engine $CROWDIN_FALLBACK_MT_ENGINE_ID (untranslated only)\"; crowdin pre-translate --method mt --engine-id=$CROWDIN_FALLBACK_MT_ENGINE_ID; fi'",
    "i18n:upload-translations": "crowdin upload translations",
    "i18n:download": "crowdin download",
    "i18n:sync": "npm run i18n:extract && npm run i18n:upload && npm run i18n:pretranslate && npm run i18n:download",
    "i18n:status": "node ./scripts/check-translation-status.js",
    "i18n:check-missing": "node ./scripts/check-missing-keys.js",
    "i18n:pre-build": "npm run i18n:download && npm run i18n:check",
    "dev": "next dev -p 8082",
    "dev:experimental": "SKIP_NODE_VERSION_CHECK=1 next dev --experimental-https",
    "start": "next start -p 8082",
    "build": "next build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "yarn clean && yarn install && yarn dev",
    "re:build": "yarn clean && yarn install && yarn build",
    "re:build-npm": "npm run clean && npm install && npm run build",
    "tsc:dev": "yarn dev & yarn tsc:watch",
    "tsc:watch": "tsc --noEmit --watch",
    "tsc:print": "npx tsc --showConfig",
    "i18n:check": "i18n-check -s en --locales src/locales/langs -f i18next",
    "i18n:sync-keys": "node ./scripts/sync-i18n-keys.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run i18n:check && npm run lint && npm run fm:check && echo 'All checks passed✅'",
    "validate:address": "node ./scripts/validate-address.js",
    "convert:contract": "node ./scripts/convert-contract-address.js",
    "commit": "cz",
    "semantic-release": "semantic-release",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.1.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/nunito-sans": "^5.1.1",
