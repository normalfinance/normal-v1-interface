{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    // Environment context
    "NODE_ENV",
    "VERCEL_GIT_BRANCH",
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "SKIP_NODE_VERSION_CHECK",
    "EDGE_CONFIG",

    // Public URLs
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_CDN_URL",
    "NEXT_PUBLIC_ASSETS_DIR",

    // Active network selector
    "NEXT_PUBLIC_NETWORK",

    // Network-specific Stellar endpoints
    "NEXT_PUBLIC_TESTNET_NETWORK_PASSPHRASE",
    "NEXT_PUBLIC_TESTNET_HORIZON_URL",
    "NEXT_PUBLIC_TESTNET_RPC_URL",

    "NEXT_PUBLIC_MAINNET_NETWORK_PASSPHRASE",
    "NEXT_PUBLIC_MAINNET_HORIZON_URL",
    "NEXT_PUBLIC_MAINNET_RPC_URL",

    // Crisp
    "NEXT_PUBLIC_CRISP_WEBSITE_ID",
    "CRISP_SECRET_KEY",

    // External services that may affect static builds or analytics initialization
    "EDGE_CONFIG",
    "NEXT_PUBLIC_ANNOUNCEMENT_TITLE",
    "NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE",
    "NEXT_PUBLIC_ANNOUNCEMENT_FORMAT",
    "NEXT_PUBLIC_ONRAMPER_API_KEY",
    "NEXT_PUBLIC_TESTNET_POSTHOG_PROJECT_NAME",
    "NEXT_PUBLIC_TESTNET_POSTHOG_KEY",
    "NEXT_PUBLIC_MAINNET_POSTHOG_PROJECT_NAME",
    "NEXT_PUBLIC_MAINNET_POSTHOG_KEY",

    // Database URLs (used by both Next.js server actions and build-time validation)
    "DATABASE_TESTNET_URL", // 6543
    "DATABASE_MAINNET_URL",
    "DATABASE_DIRECT_TESTNET_URL", // 5432
    "DATABASE_DIRECT_MAINNET_URL",

    // MoneyGram
    "MGI_ACCESS_HOST",
    "HORIZON_NETWORK_PASSPHRASE",
    "CLIENT_DOMAIN",
    "AUTH_PUBLIC_KEY",
    "AUTH_SECRET_KEY",

    // CloudFlare
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",

    // Missing
    "POSTHOG_TESTNET_ENV_ID",
    "POSTHOG_TESTNET_API_KEY",
    "POSTHOG_MAINNET_ENV_ID",
    "POSTHOG_MAINNET_API_KEY",

    // Stellar Transactions
    "NEXT_PUBLIC_STELLAR_FEE",
    "NEXT_PUBLIC_STELLAR_TIMEOUT",
    "NEXT_PUBLIC_STELLAR_STARTING_BALANCE",

    "ADMIN_SECRET",

    "FORCE_RATE_LIMIT",

    "COINBASE_KEY_ID",
    "COINBASE_SECRET",
    "DATABASE_URL",
    "DIRECT_URL",
    "GEOIP_ENDPOINT",
    "GEOIP_KEY",
    "UPSTASH_REDIS_TESTNET_REST_URL",
    "UPSTASH_REDIS_TESTNET_REST_TOKEN",
    "UPSTASH_REDIS_MAINNET_REST_URL",
    "UPSTASH_REDIS_MAINNET_REST_TOKEN",

    // ---- Added 2026-08-24 (#30). Every variable below was READ by the app
    // but not declared here, so turbo could not see a change to it and would
    // serve a cached build compiled with the previous value. The test at
    // src/utils/turbo-env-audit.test.ts fails CI if this list falls behind again.

    // Turnkey wallets (rpId is inlined at build time)
    "NEXT_PUBLIC_TURNKEY_RP_ID",
    "TURNKEY_API_PRIVATE_KEY",
    "TURNKEY_API_PUBLIC_KEY",
    "TURNKEY_ORGANIZATION_ID",

    // Autopilot delegation (one-signature swaps)
    "AUTOPILOT_API_PRIVATE_KEY",
    "AUTOPILOT_API_PUBLIC_KEY",
    "AUTOPILOT_DISABLED",
    "AUTOPILOT_IDLE_EXPIRY_DAYS",
    "AUTOPILOT_MAX_DAILY_USD",
    "AUTOPILOT_MAX_TX_USD",
    "NEXT_PUBLIC_AUTOPILOT_PUBLIC_KEY",

    // CCTP bridge + relayer
    "CCTP_PILOT_MAX_USD",
    "CCTP_RELAYER_EVM_PRIVATE_KEY",
    "CCTP_RELAYER_STELLAR_SECRET",
    "CCTP_RPC_URL_BASE",
    "CCTP_RPC_URL_ETHEREUM",

    // Swap providers
    "LIFI_API_KEY",
    "LIFI_FEE",
    "NEXT_PUBLIC_LIFI_INTEGRATOR",
    "SOROSWAP_API_BASE_URL",
    "SOROSWAP_API_KEY",
    "SOROSWAP_EMBEDDED_FEE",

    // Savings / DeFindex / Blend
    "DEFINDEX_API_KEY",
    "NEXT_PUBLIC_MAINNET_DEFINDEX_VAULT",
    "NEXT_PUBLIC_TESTNET_BLEND_USDC_ADDRESS",
    "NEXT_PUBLIC_TESTNET_BLEND_USDC_ISSUER",
    "NEXT_PUBLIC_TESTNET_DEFINDEX_VAULT",

    // Chain data + RPC providers
    "COINGECKO_API_KEY",
    "ETHERSCAN_API_KEY",
    "HELIUS_API_KEY",
    "NEXT_PUBLIC_ETH_RPC_URL",
    "NEXT_PUBLIC_SOLANA_RPC_URL",
    "NEXT_PUBLIC_SOL_RPC_URL",

    // Supabase
    "NEXT_PUBLIC_MAINNET_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_MAINNET_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_TESTNET_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_TESTNET_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",

    // Stellar contracts, issuers and oracles
    "NEXT_PUBLIC_MAINNET_ADMIN",
    "NEXT_PUBLIC_MAINNET_DISTRIBUTOR",
    "NEXT_PUBLIC_MAINNET_HOT_A",
    "NEXT_PUBLIC_MAINNET_ISSUER",
    "NEXT_PUBLIC_MAINNET_REFLECTOR_EXTERNAL_ORACLE",
    "NEXT_PUBLIC_MAINNET_REFLECTOR_PUBNET_ORACLE",
    "NEXT_PUBLIC_MAINNET_USDC_ADDRESS",
    "NEXT_PUBLIC_MAINNET_USDC_ISSUER",
    "NEXT_PUBLIC_MAINNET_XLM_ADDRESS",
    "NEXT_PUBLIC_TESTNET_ADMIN",
    "NEXT_PUBLIC_TESTNET_DISTRIBUTOR",
    "NEXT_PUBLIC_TESTNET_HOT_A",
    "NEXT_PUBLIC_TESTNET_ISSUER",
    "NEXT_PUBLIC_TESTNET_REFLECTOR_EXTERNAL_ORACLE",
    "NEXT_PUBLIC_TESTNET_REFLECTOR_PUBNET_ORACLE",
    "NEXT_PUBLIC_TESTNET_USDC_ADDRESS",
    "NEXT_PUBLIC_TESTNET_USDC_ISSUER",
    "NEXT_PUBLIC_TESTNET_XLM_ADDRESS",

    // Normal fees
    "NORMAL_FEES_DEPOSIT_ADDRESS",
    "NORMAL_SWAP_FEE_BPS",

    // Ops, jobs and analytics
    "CRON_SECRET",
    "CUSTOMERIO_API_KEY",
    "CUSTOMERIO_SITE_ID",
    "DUNE_API_KEY",
    "DUNE_NAMESPACE",

    // Build + feature flags
    "BUILD_STATIC_EXPORT",
    "NEXT_PUBLIC_ALLOW_NETWORK_SWITCH",
    "X",
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "main/**", "module/**", "types/**", ".next/**"],
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
    },
    "lint": {
      "outputs": [],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
    },
  },
}
